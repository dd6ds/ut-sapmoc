# Build container for ut-sapmoc on Ubuntu Touch 26.04 (Resolute, arm64).
#
# The app uses the phone's own Qt (6.10, framework ubuntu-touch-26.04-1.x):
# the OpenStore accepts only the Qt versions of the Ubuntu Touch frameworks.
# Qt comes from the UBports repository (the same build as on the phone; its
# private API, used by Qt6OpenGLWidgets, must match exactly).
#
#   docker build -t ut-sapmoc:resolute-arm64 -f Dockerfile.resolute-arm64 .
# clickable.json uses this image name.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL http://repo.ubports.com/keyring.gpg -o /usr/share/keyrings/ubports.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/ubports.gpg] http://repo.ubports.com/ 26.04-1.x main" \
         > /etc/apt/sources.list.d/ubports.list \
    && printf 'Package: *\nPin: origin repo.ubports.com\nPin-Priority: 1001\n' \
         > /etc/apt/preferences.d/ubports.pref \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --allow-downgrades --no-install-recommends \
        bash git wget jq file rsync pkg-config ccache optipng patch xz-utils \
        build-essential clang cmake ninja-build \
        python3 python3-venv python3-pip \
        qt6-base-dev \
        qt6-positioning-dev \
        qt6-svg-dev \
        libqt6wlshellintegration6 \
        qt6-translations-l10n \
        libfreetype-dev \
        libglvnd-dev \
        libgl1-mesa-dev \
        libharfbuzz-dev \
        libicu-dev \
        icu-devtools \
        libsqlite3-dev \
        zlib1g-dev \
        libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
        libc++-dev \
        libdbus-1-dev \
        libttspico-dev libttspico-data \
        libpulse-dev \
        click \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /project
